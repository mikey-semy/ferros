/* Линкер-скрипт пользовательской программы (M5c1).
 *
 * Фиксируем базу загрузки на 0x40_0000 (классический адрес текста ELF, свободен в нашем
 * адресном пространстве) и выравниваем секции по странице 4 КиБ, чтобы PT_LOAD-сегменты
 * были постранично выровнены — это упрощает наш минимальный загрузчик в ядре.
 */
ENTRY(_start)

SECTIONS {
    . = 0x400000;

    .text : { *(.text .text.*) }
    . = ALIGN(4096);

    .rodata : { *(.rodata .rodata.*) }
    . = ALIGN(4096);

    .data : { *(.data .data.*) }
    .bss : { *(.bss .bss.*) }

    /DISCARD/ : { *(.eh_frame) *(.eh_frame_hdr) *(.note .note.*) *(.comment) }
}
