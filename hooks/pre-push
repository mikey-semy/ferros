#!/bin/sh
# ferros local CI — runs before every `git push`. See docs/CONTRIBUTING.md.
# Activate once per clone with:  git config core.hooksPath hooks
set -e

echo "[pre-push] cargo fmt --check"
cargo fmt --check

echo "[pre-push] cargo clippy -- -D warnings"
cargo clippy -- -D warnings

echo "[pre-push] cargo build"
cargo build

# `cargo test` runs the kernel's tests inside QEMU; make sure QEMU is on PATH.
export PATH="$HOME/qemu:$PATH"
echo "[pre-push] cargo test"
cargo test

echo "[pre-push] all checks passed"
